<?xml version="1.0" encoding="utf-8"?>
<component type="desktop">
    <id>io.github.w0rd3r566.libregram</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0</project_license>
    <name>LibreGram</name>
    <summary>Experimental Telegram messenger</summary>
    <description>
        <p>Unofficial messaging app based on Telegram Desktop and Kotatogram.</p>
        <p>Telegram is a popular messaging protocol with encryption and security as its key focus.</p>
    </description>
    <categories>
        <category>Network</category>
        <category>InstantMessaging</category>
    </categories>
    <developer_name>LibreGram contributors</developer_name>
    <url type="homepage">https://github.com/W0rd3r566/libregram-desktop</url>
    <url type="bugtracker">https://github.com/W0rd3r566/libregram-desktop</url>
    <url type="vcs-browser">https://github.com/W0rd3r566/libregram-desktop</url>
    <url type="contribute">https://github.com/W0rd3r566/libregram-desktop</url>
    <branding>
        <color type="primary" scheme_preference="light">#10b9df</color>
        <color type="primary" scheme_preference="dark">#20242b</color>
    </branding>
    <keywords>
        <keyword>tg</keyword>
        <keyword>telegram</keyword>
        <keyword>libregram</keyword>
        <keyword>tdesktop</keyword>
        <keyword>messaging</keyword>
        <keyword>messenger</keyword>
        <keyword>chat</keyword>
        <keyword>sms</keyword>
        <keyword>im</keyword>
    </keywords>
    <requires>
        <!-- windowMinHeight from Telegram/SourceFiles/window/window.style -->
        <display_length compare="ge">480</display_length>
        <internet>always</internet>
        <!-- on-screen keyboards are too big for current minimal display height -->
        <control>keyboard</control>
    </requires>
    <supports>
        <control>pointing</control>
        <control>touch</control>
    </supports>
    <content_rating type="oars-1.1">
        <content_attribute id="violence-cartoon">none</content_attribute>
