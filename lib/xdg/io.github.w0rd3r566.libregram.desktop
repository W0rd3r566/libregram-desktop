[Desktop Entry]
Name=LibreGram
Comment=Experimental Telegram Desktop fork
TryExec=LibreGram
Exec=LibreGram -- %U
Icon=io.github.w0rd3r566.libregram
Terminal=false
StartupWMClass=LibreGramDesktop
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Keywords=tg;chat;im;messaging;messenger;sms;tdesktop;libregram;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=LibreGram -quit
Name=Quit LibreGram
Icon=application-exit
